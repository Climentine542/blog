---
/** 自绘唱片视觉由 SVG 构成；相邻文案已经说明去向，不重复朗读装饰图。 */
const grooves = [37, 42, 48, 54, 60, 66, 72, 78, 84, 90, 96, 102, 108, 114, 120];
---

<svg viewBox="0 0 480 390" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="cover" x2="1" y2="1" gradientUnits="objectBoundingBox">
      <stop stop-color="#427d6b" /><stop offset="1" stop-color="#23453c" />
    </linearGradient>
    <linearGradient id="vinyl" x1="0" x2="1" y1="1" y2="0" gradientUnits="objectBoundingBox">
      <stop stop-color="#1b2b29" /><stop offset=".48" stop-color="#30443e" /><stop offset=".62" stop-color="#172421" /><stop offset="1" stop-color="#344940" />
    </linearGradient>
  </defs>
  <circle cx="252" cy="177" r="155" fill="none" stroke="#cad3c7" />
  <circle cx="252" cy="177" r="174" fill="none" stroke="#dfe2d8" stroke-dasharray="3 8" />
  <path d="M68 297h38m-19-19v38m321-240h22m-11-11v22" stroke="#9aa99f" fill="none" />
  <g transform="rotate(-12 230 190)">
    <circle cx="316" cy="185" r="129" fill="url(#vinyl)" stroke="#182824" stroke-width="2" />
    {grooves.map((radius) => <circle cx="316" cy="185" r={radius} fill="none" stroke="#879990" opacity=".3" />)}
    <circle cx="316" cy="185" r="33" fill="#dbab65" />
    <circle cx="316" cy="185" r="4" fill="#233930" />
    <path d="M343 138a56 56 0 0 1 26 40M366 128a73 73 0 0 1 21 54" fill="none" stroke="#d2e0d7" opacity=".35" stroke-width="2" />
    <rect x="73" y="62" width="242" height="242" rx="9" fill="#1a342b" opacity=".22" transform="translate(7 12)" />
    <rect x="73" y="62" width="242" height="242" rx="8" fill="url(#cover)" />
    <rect x="85" y="74" width="218" height="218" rx="4" fill="none" stroke="#adcbac" opacity=".55" />
    <path d="M86 238c36-12 49-52 73-53 27-2 29 34 54 29 29-6 44-60 90-40v118H86z" fill="#5d937a" />
    <path d="M86 259c35-32 58-33 88-14 24 15 40 17 62-4 24-22 51-26 67-18v69H86z" fill="#31594d" />
    <path d="M86 251c36-12 49-49 73-50 25-1 32 35 57 29 28-7 42-58 87-39m-217 77c38-31 60-31 89-13 26 17 43 16 63-3 21-20 45-27 65-20" fill="none" stroke="#a5c4ab" opacity=".72" />
    <circle cx="248" cy="141" r="25" fill="#ebc180" />
    <path d="M117 114h38m-38 9h25m-25 147h26m-26 8h16" stroke="#d5e5d6" stroke-linecap="round" opacity=".8" />
  </g>
</svg>

<style>
  svg { display: block; width: 100%; height: auto; overflow: visible; }
</style>
