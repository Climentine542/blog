---
import MusicPlayer from '../components/MusicPlayer.astro';
import PageIntro from '../components/PageIntro.astro';
import tracks from '../data/music.json';
import { sectionDescriptions } from '../data/section-descriptions';
import BaseLayout from '../layouts/BaseLayout.astro';

const description = sectionDescriptions.music;
---

<BaseLayout title="音乐" {description} section="music">
  <PageIntro kicker="MUSIC / 单曲" title="音乐" {description} />
  <div class="section">
    <MusicPlayer {tracks} />
  </div>
</BaseLayout>
